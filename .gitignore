# Ignore node_modules (in case build tooling is added later)
node_modules/
npm-debug.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini
docs/*.webm

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Build artifacts
# NOTE: assets/js/dist/ is an exception (see below) — those are the
# compiled Text Animation bundles the plugin actually loads at runtime.
# They're committed on purpose so the plugin works with zero build step
# for end users; only assets/js/src/ + node_modules/ require Node/npm.
dist/
build/
_dist_temp/
*.min.js.map
*.min.css.map
!assets/js/dist/
!assets/js/dist/**

# WordPress specific
wp-config.php
wp-content/uploads/

# Composer
composer.lock

# PHPUnit
phpunit.xml
.phpunit.result.cache
tests/

# Coverage
coverage/
*.coverage

# Logs
*.log

# Tests
_tests/
*.zip