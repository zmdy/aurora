{
  "name": "aurora",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "description": "The open-source Swiss Army knife for animated web design. Monorepo: shared core, animation modules and builder adapters.",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "build:elementor": "node tools/generate-elementor.mjs",
    "pack": "node tools/pack-elementor.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:php": "php adapters/elementor/test/stub-test.php"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "jsdom": "^25.0.1",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  },
  "allowScripts": {
    "esbuild@0.24.2": true,
    "esbuild@0.21.5": true
  },
  "workspaces": [
    "packages/*"
  ]
}
